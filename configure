# One-click IoT gateway deployment script for Raspberry Pi 4 and 5 running
# 64-bit Raspberry Pi OS Bookworm or Trixie.
#
# Environment variables:
#     BERRYNET_ENGINE               AI engine of the default application,
#                                   litert (default) or onnx.
#     BERRYNET_MODELS               Model packages to install, see
#                                   "bn_model available".
#     BERRYNET_SKIP_PLATFORM_CHECK  Set to 1 to install on other Debian-based
#                                   systems, e.g. in a container.

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exec sudo --preserve-env=BERRYNET_ENGINE,BERRYNET_MODELS,BERRYNET_SKIP_PLATFORM_CHECK \
        "$0" "$@"
fi

SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG="$PWD/berrynet-install.log"
PREFIX="/opt/berrynet"
VENV="$PREFIX/venv"
DASHBOARD_DIR="$PREFIX/dashboard"
MODEL_DIR="/usr/share/dlmodels"
ENGINE="${BERRYNET_ENGINE:-litert}"
MODELS="${BERRYNET_MODELS:-ssd-mobilenet-v1-coco-$ENGINE}"
SKIP_PLATFORM_CHECK="${BERRYNET_SKIP_PLATFORM_CHECK:-0}"
UV_VERSION="0.13.6"
FREEBOARD_REPO="https://github.com/Freeboard/freeboard.git"
FREEBOARD_COMMIT="38789f6e8bd3d04f7d3b2c3427e509d00f2610fc"

exec > >(tee -a "$LOG") 2>&1

die() {
    echo "ERROR: $*"
    echo "Set BERRYNET_SKIP_PLATFORM_CHECK=1 to install anyway."
    exit 1
}

check_platform() {
    local model arch codename
    model="$(tr -d '\0' < /proc/device-tree/model 2> /dev/null || true)"
    arch="$(dpkg --print-architecture)"
    codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"

    case "$model" in
    "Raspberry Pi 4"* | "Raspberry Pi 5"* | \
    "Raspberry Pi Compute Module 4"* | "Raspberry Pi Compute Module 5"*)
        ;;
    *)
        die "BerryNet supports Raspberry Pi 4 and 5, but this is '${model:-unknown}'."
        ;;
    esac
    if [ "$arch" != "arm64" ]; then
        die "BerryNet needs 64-bit (arm64) Raspberry Pi OS, but this is $arch."
    fi
    case "$codename" in
    bookworm | trixie)
        ;;
    *)
        die "BerryNet supports Raspberry Pi OS Bookworm and Trixie, but this is '${codename:-unknown}'."
        ;;
    esac
    echo "Platform: $model, $codename, $arch"
}

install_system_dependencies() {
    apt-get update
    # libgl1 and libglib2.0-0 are needed by OpenCV.
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        mosquitto \
        mosquitto-clients \
        python3 \
        python3-venv \
        supervisor
    # rpicam-vid reads the Raspberry Pi camera module.
    if ! command -v rpicam-vid > /dev/null && \
            apt-cache show rpicam-apps-lite > /dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive apt-get install -y rpicam-apps-lite
    fi
}

install_berrynet() {
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install --quiet "uv==$UV_VERSION"
    # Keep uv itself in the venv (--inexact), and do not link the venv to
    # this source directory (--no-editable).
    pushd "$SRC_DIR" > /dev/null
    UV_PROJECT_ENVIRONMENT="$VENV" "$VENV/bin/uv" sync \
        --locked --inexact --no-dev --no-editable \
        --python "$VENV/bin/python" \
        --extra litert --extra onnx --extra opencv
    rm -rf build berrynet.egg-info
    popd > /dev/null
    for cmd in "$VENV"/bin/bn_*; do
        ln -sf "$cmd" /usr/local/bin/
    done
}

install_models() {
    # shellcheck disable=SC2086
    "$VENV/bin/bn_model" --basedir "$MODEL_DIR" install $MODELS
}

install_dashboard() {
    rm -rf "$DASHBOARD_DIR"
    git clone --quiet "$FREEBOARD_REPO" "$DASHBOARD_DIR"
    git -C "$DASHBOARD_DIR" -c advice.detachedHead=false \
        checkout --quiet "$FREEBOARD_COMMIT"
    git -C "$DASHBOARD_DIR" apply "$SRC_DIR/patch/ui-berrynet-theme.patch"
    rm -rf "$DASHBOARD_DIR/.git"
    cp -r "$SRC_DIR/patch/www/freeboard/." "$DASHBOARD_DIR/"
    cp "$SRC_DIR"/config/dashboard-*.json "$DASHBOARD_DIR/"
}

install_configs() {
    local conf_dir="/etc/supervisor/conf.d"
    local engine_conf="$conf_dir/berrynet-$ENGINE.conf"

    mkdir -p /var/log/berrynet
    # Remove configs of the other engine and of earlier BerryNet versions,
    # which run another camera client.
    rm -f "$conf_dir"/berrynet-{litert,onnx,tflite,darknet,movidius}.conf
    cp "$SRC_DIR/config/supervisor/conf.d/berrynet-$ENGINE.conf" "$conf_dir/"
    cp "$SRC_DIR/config/supervisor/conf.d/berrynet-dashboard.conf" "$conf_dir/"
    # Use the Raspberry Pi camera module if there is one, or a USB camera.
    if command -v rpicam-hello > /dev/null && \
            rpicam-hello --list-cameras 2> /dev/null | grep -q '^[0-9]* : '; then
        echo "Found Raspberry Pi camera module"
        sed -i 's/^command=bn_camera /command=bn_camera --stream-src picamera /' \
            "$engine_conf"
    fi

    cp "$SRC_DIR/config/etc/mosquitto/conf.d/berrynet.conf" \
        /etc/mosquitto/conf.d/
}

update_system_service() {
    if [ -d /run/systemd/system ]; then
        systemctl enable mosquitto supervisor
        systemctl restart mosquitto supervisor
    else
        echo "systemd is not running, please start mosquitto and supervisor manually."
    fi
}

case "$ENGINE" in
litert | onnx)
    ;;
*)
    echo "ERROR: BERRYNET_ENGINE should be litert or onnx, but it is '$ENGINE'."
    exit 1
    ;;
esac
if [ "$SKIP_PLATFORM_CHECK" != "1" ]; then
    check_platform
fi
install_system_dependencies
install_berrynet
install_models
install_dashboard
install_configs
update_system_service

cat << EOF
Installation is completed successfully!

Dashboard: http://<IP address of this device>:8080/#source=dashboard-${ENGINE}detector.json

If there is any issue, please open an issue on

    https://github.com/DT42/BerryNet/issues

and attach this log:

    $LOG

We are happy to check and fix it, thank you!
EOF
